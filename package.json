{
  "name": "slabbbed",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler dev",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "db:migrate": "wrangler d1 execute slabbed-db --local --file=worker/schema.sql",
    "db:migrate:remote": "wrangler d1 execute slabbed-db --remote --file=worker/schema.sql",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@jsquash/webp": "^1.5.0",
    "barcode-detector": "^3.2.2",
    "heic-to": "^1.6.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261003.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "sass-embedded": "^1.105.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.147.0"
  }
}
